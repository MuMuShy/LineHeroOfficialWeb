---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavbarAstro from '../components/NavbarAstro';
import { GameIntroLinePage } from '../components/StaticPages';
import FooterAstro from '../components/FooterAstro';
import ScrollToTop from '../components/ScrollToTop';
import '../styles/global.css';

const seoProps = {
  title: "LINE版玩法介紹 | LINE Hero 無盡冒險",
  description: "LINE 聊天室就是你的遊戲視窗！指令操作、快速戰鬥，最適合上班族的偷閒神器。",
  url: "https://linehero.tw/game-intro-line"
};
---

<BaseLayout {...seoProps}>
  <NavbarAstro client:load />
  <main>
    <GameIntroLinePage client:load />
  </main>
  <FooterAstro client:load />
  <ScrollToTop client:load />
</BaseLayout>
