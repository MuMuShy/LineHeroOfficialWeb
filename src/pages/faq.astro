---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavbarAstro from '../components/NavbarAstro';
import FAQPage, { getFAQSchema } from '../components/FAQPage';
import FooterAstro from '../components/FooterAstro';
import ScrollToTop from '../components/ScrollToTop';
import '../styles/global.css';

const faqSchema = getFAQSchema();

const seoProps = {
  title: "FAQ 常見問題｜LINE Hero 無盡冒險（新手／儲值／退款）",
  description: "LINE Hero FAQ：如何開始、升級配裝、參加副本、Boss 玩法、儲值與退款規則一次整理。找不到答案？到官方社群快速詢問。",
  url: "https://linehero.tw/faq",
  schema: faqSchema
};
---

<BaseLayout {...seoProps}>
  <NavbarAstro client:load />
  <main>
    <FAQPage client:load />
  </main>
  <FooterAstro client:load />
  <ScrollToTop client:load />
</BaseLayout>
