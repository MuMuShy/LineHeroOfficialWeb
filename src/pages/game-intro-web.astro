---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavbarAstro from '../components/NavbarAstro';
import { GameIntroWebPage } from '../components/StaticPages';
import FooterAstro from '../components/FooterAstro';
import ScrollToTop from '../components/ScrollToTop';
import '../styles/global.css';

const seoProps = {
  title: "Web 版介紹｜LINE Hero 無盡冒險（大螢幕管理）",
  description: "LINE Hero Web 版提供更好用的管理介面與數據檢視：背包/裝備/排行/探索，一台電腦就能更有效率地安排養成。",
  url: "https://linehero.tw/game-intro-web"
};
---

<BaseLayout {...seoProps}>
  <NavbarAstro client:load />
  <main>
    <GameIntroWebPage client:load />
  </main>
  <FooterAstro client:load />
  <ScrollToTop client:load />
</BaseLayout>
