---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavbarAstro from '../components/NavbarAstro';
import SocialFeaturePage from '../components/feature-pages/SocialFeaturePage';
import FooterAstro from '../components/FooterAstro';
import ScrollToTop from '../components/ScrollToTop';
import '../styles/global.css';

const seoProps = {
  title: "社交與酒館教學 | LINE Hero 無盡冒險",
  description: "社交看板與酒館小遊戲玩法介紹。",
  url: "https://linehero.tw/feature-social"
};
---

<BaseLayout {...seoProps}>
  <NavbarAstro client:load />
  <main>
    <SocialFeaturePage client:load />
  </main>
  <FooterAstro client:load />
  <ScrollToTop client:load />
</BaseLayout>
