---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavbarAstro from '../components/NavbarAstro';
import Hero from '../components/Hero';
import Features from '../components/Features';
import Characters from '../components/Characters';
import Gallery from '../components/Gallery';
import FooterAstro from '../components/FooterAstro';
import ScrollToTop from '../components/ScrollToTop';
import { getFAQSchema } from '../components/FAQPage';
import '../styles/global.css';

const seoProps = {
  title: "免下載 RPG｜LINE Hero 無盡冒險（LINE RPG・網頁 RPG・世界Boss）",
  description: "免下載、免安裝，打開 LINE 就能玩的 RPG。支援 Web 模式（網頁 RPG）在大螢幕管理與探索；大世界世界 Boss、陣營對抗、自動戰鬥與裝備養成一次體驗。",
  keywords: "免下載RPG, 免下載 RPG, LINE RPG, LINE遊戲, 網頁RPG, 網頁 RPG, 網頁遊戲, 自動戰鬥RPG, 世界Boss遊戲, 放置冒險遊戲",
  // 首頁保留 FAQ 結構化資料（rich result 可能性）
  schema: getFAQSchema(),
  url: "https://linehero.tw/"
};
---

<BaseLayout {...seoProps}>
  <NavbarAstro client:load />
  <main>
    <Hero client:load />
    <Features client:load />
    <Characters client:load />
    <Gallery client:load />

    <!-- Call to Action Section -->
    <section class="py-24 bg-gradient-to-t from-hero-dark to-gray-900 relative overflow-hidden border-t border-white/10 section-divider">
      <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1605806616949-1e87b487bc2a?q=80&w=1974&auto=format&fit=crop')] opacity-10 bg-cover bg-center"></div>
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-hero-green/10 rounded-full blur-[140px]"></div>
      <div class="absolute bottom-0 right-0 w-[420px] h-[420px] bg-hero-gold/10 rounded-full blur-[120px]"></div>
      <div class="relative z-10 text-center max-w-4xl mx-auto px-4">
        <h2 class="text-4xl md:text-6xl font-black text-white mb-6 leading-tight">
          準備好體驗免下載的 LINE 即玩 RPG 嗎？<br />
          <span class="text-hero-gold text-shadow-gold">打開聊天視窗直接開戰</span>
        </h2>
        <p class="text-gray-300 mb-10 text-lg max-w-2xl mx-auto font-medium">
          免下載、免安裝、免註冊，只需 1 秒。
          <br />
          加入官方帳號、掃描 QR Code，您的<span class="text-white font-bold">聊天視窗 RPG</span> 冒險即刻開始。
        </p>

        <div class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-8 items-center bg-white/5 p-6 md:p-8 rounded-3xl border border-white/10 backdrop-blur-sm shadow-[0_30px_60px_rgba(0,0,0,0.35)]">
          <!-- QR Code Block -->
          <div class="bg-white p-4 rounded-2xl shadow-xl ring-1 ring-white/40 mx-auto w-fit">
            <img
              src="https://qr-official.line.me/gs/M_765llgvq_GW.png?oat_content=qr"
              alt="Line Hero QR Code"
              class="w-44 h-44 sm:w-48 sm:h-48 md:w-52 md:h-52"
            />
            <p class="text-black text-[11px] font-black mt-2 uppercase tracking-wider">Scan to Play</p>
          </div>

          <!-- Buttons Block -->
          <div class="flex flex-col gap-4 w-full">
            <a
              href="https://lin.ee/3JlUhak"
              target="_blank"
              rel="noreferrer"
              class="w-full md:w-auto bg-[#06C755] hover:bg-[#05b64d] text-white px-8 py-4 rounded-xl flex items-center justify-center gap-4 transition-all transform hover:scale-105 shadow-[0_0_20px_rgba(6,199,85,0.4)] font-bold text-xl min-w-[280px] group relative overflow-hidden"
            >
              <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent translate-x-[-100%] group-hover:animate-shine-fast"></div>
              <svg class="w-8 h-8 relative z-10" fill="currentColor" viewBox="0 0 24 24">
                <path d="M21.5 12a9.5 9.5 0 1 1-19 0 9.5 9.5 0 0 1 19 0zM12 17.5c4.5 0 8-3 8-6.5s-3.5-6.5-8-6.5-8 3-8 6.5 3.5 6.5 8 6.5z" />
                <path d="M10 15.5l6-3.5-6-3.5v7z" fill="white" />
              </svg>
              <div class="relative z-10">
                <div class="text-xs font-medium opacity-80 text-left">立即加入好友</div>
                <div class="text-lg">開啟 LINE 冒險</div>
              </div>
            </a>
            <!-- 3-step onboarding（降低新手理解成本） -->
            <div class="w-full md:w-auto min-w-[280px] text-left bg-black/30 border border-white/10 rounded-2xl px-6 py-5">
              <div class="text-xs uppercase tracking-[0.25em] text-gray-300 font-bold mb-3">如何開始（30 秒）</div>
              <ol class="space-y-2 text-sm text-gray-200">
                <li><span class="text-hero-gold font-bold">1.</span> 點上面的按鈕加入官方帳號</li>
                <li><span class="text-hero-gold font-bold">2.</span> 在聊天室點「開始 / 新手教學」</li>
                <li><span class="text-hero-gold font-bold">3.</span> 立刻探索、戰鬥、領新手禮包</li>
              </ol>

              <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-2">
                <a
                  href="/no-download-rpg"
                  class="w-full bg-white/5 hover:bg-white/10 text-white px-4 py-3 rounded-xl flex items-center justify-center gap-2 transition-all border border-white/10 hover:border-hero-gold font-bold text-sm"
                >
                  免下載 RPG 介紹
                </a>
                <a
                  href="/line-rpg"
                  class="w-full bg-white/5 hover:bg-white/10 text-white px-4 py-3 rounded-xl flex items-center justify-center gap-2 transition-all border border-white/10 hover:border-hero-gold font-bold text-sm"
                >
                  LINE RPG 玩法
                </a>
              </div>

              <div class="mt-4 flex flex-wrap gap-3 text-xs text-gray-300">
                <a href="/web-rpg" class="hover:text-white underline underline-offset-4">網頁 RPG（Web 模式）</a>
                <a href="https://wiki.linehero.tw" target="_blank" rel="noreferrer" class="hover:text-white underline underline-offset-4">Wiki 攻略</a>
                <a href="/beginner-guide" class="hover:text-white underline underline-offset-4">官網新手攻略</a>
                <a href="https://discord.gg/76gSTeqtBw" target="_blank" rel="noopener noreferrer" class="hover:text-white underline underline-offset-4">Discord</a>
              </div>

              <div class="mt-4 text-xs text-gray-400 leading-relaxed">
                <div class="font-bold text-gray-300 mb-1">安心玩：</div>
                <ul class="list-disc pl-5 space-y-1">
                  <li>免下載、免安裝、可免費開始</li>
                  <li>遊戲進度綁定帳號，資料雲端保存</li>
                  <li>不蒐集你的對話紀錄/好友名單</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <FooterAstro client:load />
  <ScrollToTop client:load />
</BaseLayout>
