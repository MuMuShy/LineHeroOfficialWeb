---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavbarAstro from '../components/NavbarAstro';
import Hero from '../components/Hero';
import Features from '../components/Features';
import Characters from '../components/Characters';
import Gallery from '../components/Gallery';
import FooterAstro from '../components/FooterAstro';
import ScrollToTop from '../components/ScrollToTop';
import { getFAQSchema } from '../components/FAQPage';
import '../styles/global.css';

const seoProps = {
  title: "免下載 RPG｜LINE Hero 無盡冒險（LINE RPG・網頁 RPG・世界 Boss・自動戰鬥）",
  description: "免下載、免安裝，打開 LINE 就能玩的 RPG。支援 Web 模式（網頁 RPG）在大螢幕管理與探索，世界 Boss、陣營對抗、自動戰鬥與裝備養成一次體驗，適合上班族與碎片時間遊玩。",
  keywords: "免下載RPG, 免下載 RPG, LINE RPG, LINE遊戲, 網頁RPG, 網頁 RPG, 網頁遊戲, 自動戰鬥RPG, 世界Boss遊戲, 放置冒險遊戲",
  // 首頁保留 FAQ 結構化資料（rich result 可能性）
  schema: getFAQSchema(),
  url: "https://linehero.tw/"
};
---

<BaseLayout {...seoProps}>
  <NavbarAstro client:load />
  <main>
    <Hero client:idle />
    <Features client:visible />
    <Characters client:only="react" />
    <Gallery client:visible />

    <!-- Call to Action Section - 日系二次元 PLAY NOW -->
    <section class="relative py-24 md:py-32 bg-hero-dark overflow-hidden border-t border-white/10 section-divider">
      <!-- BG Layers -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(6,199,85,0.18),transparent_55%),radial-gradient(ellipse_at_bottom,rgba(255,215,0,0.18),transparent_55%)]"></div>
        <div class="absolute top-0 left-0 w-full h-32 diagonal-stripes-green opacity-50"></div>
        <div class="absolute bottom-0 left-0 w-full h-32 diagonal-stripes opacity-50"></div>
        <div class="absolute inset-0 halftone opacity-20"></div>
        <div
          aria-hidden
          class="absolute right-[-3rem] top-1/2 -translate-y-1/2 font-kanji-deco text-white/[0.05] leading-none select-none"
          style="font-size: clamp(20rem, 36vw, 38rem);"
        >
          始
        </div>
      </div>

      <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center mb-10 md:mb-14">
          <div class="inline-flex items-center gap-3 mb-4">
            <div class="h-[2px] w-10 bg-hero-gold"></div>
            <span class="font-en-display text-xs tracking-[0.4em] text-hero-gold">START YOUR ADVENTURE</span>
            <div class="h-[2px] w-10 bg-hero-gold"></div>
          </div>
          <h2 class="font-serif-cn text-4xl md:text-6xl text-white leading-tight">
            打開聊天視窗<span class="text-hero-gold">，</span>直接開戰
          </h2>
          <p class="mt-4 text-gray-300 text-base md:text-lg max-w-2xl mx-auto">
            免下載、免安裝、免註冊，只需 1 秒。加入官方帳號、掃描 QR Code，您的<span class="text-white font-bold">聊天視窗 RPG</span> 冒險即刻開始。
          </p>
        </div>

        <!-- Main CTA panel -->
        <div class="relative">
          <!-- Neon outer frame -->
          <div class="absolute -inset-1 clip-slash-soft bg-gradient-to-br from-hero-neon-green/70 via-hero-gold/60 to-hero-sakura/70 opacity-80"></div>
          <div class="relative clip-slash-soft bg-hero-dark/90 backdrop-blur-md border border-white/10 p-6 md:p-10">
            <div class="grid grid-cols-1 md:grid-cols-[260px_1fr] gap-8 items-center">
              <!-- QR -->
              <div class="relative mx-auto">
                <div class="absolute -top-3 -left-3 clip-slash-tag bg-hero-gold text-black font-en-display text-[10px] px-3 py-1 tracking-widest font-black z-10">
                  SCAN ME
                </div>
                <div class="bg-white p-4 rounded-2xl shadow-[0_20px_50px_rgba(255,215,0,0.25)] ring-2 ring-hero-gold/60">
                  <img
                    src="https://qr-official.line.me/gs/M_765llgvq_GW.png?oat_content=qr"
                    alt="Line Hero QR Code"
                    class="w-44 h-44 sm:w-48 sm:h-48"
                  />
                  <p class="text-black text-[11px] font-black mt-2 uppercase tracking-wider text-center font-en-display">Scan to Play</p>
                </div>
              </div>

              <!-- Buttons + guide -->
              <div class="flex flex-col gap-4">
                <a
                  href="https://lin.ee/3JlUhak"
                  target="_blank"
                  rel="noreferrer"
                  class="group relative bg-[#06C755] hover:bg-[#05b64d] text-white px-8 py-4 flex items-center justify-center gap-3 transition-transform hover:-translate-y-0.5 shadow-[0_15px_30px_rgba(6,199,85,0.3)] overflow-hidden rounded-sm"
                >
                  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/25 to-transparent translate-x-[-100%] group-hover:animate-shine-fast"></div>
                  <span class="relative z-10 font-serif-cn text-base md:text-lg tracking-[0.2em]">開啟 LINE 冒險</span>
                  <svg class="w-4 h-4 relative z-10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </a>

                <div class="bg-black/40 border border-white/10 clip-slash-soft p-5 md:p-6">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="font-en-display text-[10px] tracking-[0.3em] text-hero-gold">HOW TO START</span>
                    <div class="h-px flex-1 bg-gradient-to-r from-hero-gold/60 to-transparent"></div>
                    <span class="text-[10px] text-gray-400">30 秒</span>
                  </div>
                  <ol class="space-y-2 text-sm text-gray-200">
                    <li class="flex items-start gap-3"><span class="font-en-display text-hero-gold text-lg leading-none">01</span> 點上面的按鈕加入官方帳號</li>
                    <li class="flex items-start gap-3"><span class="font-en-display text-hero-gold text-lg leading-none">02</span> 在聊天室點「開始 / 新手教學」</li>
                    <li class="flex items-start gap-3"><span class="font-en-display text-hero-gold text-lg leading-none">03</span> 立刻探索、戰鬥、領新手禮包</li>
                  </ol>

                  <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-2">
                    <a
                      href="/no-download-rpg"
                      class="clip-slash-tag bg-white/5 hover:bg-white/10 text-white px-4 py-3 text-center transition-all border border-white/10 hover:border-hero-gold font-bold text-sm"
                    >
                      免下載 RPG 介紹
                    </a>
                    <a
                      href="/line-rpg"
                      class="clip-slash-tag bg-white/5 hover:bg-white/10 text-white px-4 py-3 text-center transition-all border border-white/10 hover:border-hero-gold font-bold text-sm"
                    >
                      LINE RPG 玩法
                    </a>
                  </div>

                  <div class="mt-4 flex flex-wrap gap-3 text-xs text-gray-300">
                    <a href="/web-rpg" class="hover:text-hero-gold underline underline-offset-4">網頁 RPG（Web 模式）</a>
                    <a href="https://wiki.linehero.tw" target="_blank" rel="noreferrer" class="hover:text-hero-gold underline underline-offset-4">Wiki 攻略</a>
                    <a href="/beginner-guide" class="hover:text-hero-gold underline underline-offset-4">官網新手攻略</a>
                    <a href="https://discord.gg/76gSTeqtBw" target="_blank" rel="noopener noreferrer" class="hover:text-hero-gold underline underline-offset-4">Discord</a>
                  </div>

                  <div class="mt-4 pt-4 border-t border-white/10 text-xs text-gray-400 leading-relaxed">
                    <div class="font-en-display text-[10px] tracking-[0.3em] text-hero-neon-green mb-2">SAFE TO PLAY</div>
                    <ul class="list-none space-y-1">
                      <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-hero-neon-green"></span>免下載、免安裝、可免費開始</li>
                      <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-hero-neon-green"></span>遊戲進度綁定帳號，資料雲端保存</li>
                      <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-hero-neon-green"></span>不蒐集你的對話紀錄／好友名單</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <FooterAstro client:load />
  <ScrollToTop client:load />
</BaseLayout>
