---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavbarAstro from '../components/NavbarAstro';
import { RefundPolicyPage } from '../components/LegalPages';
import FooterAstro from '../components/FooterAstro';
import ScrollToTop from '../components/ScrollToTop';
import '../styles/global.css';

const seoProps = {
  title: "退款政策 | LINE Hero 無盡冒險",
  description: "LINE Hero 無盡冒險退款政策，了解退款流程與相關規定。",
  url: "https://linehero.tw/refund"
};
---

<BaseLayout {...seoProps}>
  <NavbarAstro client:load />
  <main>
    <RefundPolicyPage client:load />
  </main>
  <FooterAstro client:load />
  <ScrollToTop client:load />
</BaseLayout>
