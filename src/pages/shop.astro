---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavbarAstro from '../components/NavbarAstro';
import { ShopPage } from '../components/StaticPages';
import FooterAstro from '../components/FooterAstro';
import ScrollToTop from '../components/ScrollToTop';
import '../styles/global.css';

const seoProps = {
  title: "遊戲商城 | LINE Hero 無盡冒險",
  description: "查看 LINE Hero 最新熱賣商品、超值禮包與限定造型。",
  url: "https://linehero.tw/shop"
};
---

<BaseLayout {...seoProps}>
  <NavbarAstro client:load />
  <main>
    <ShopPage client:load />
  </main>
  <FooterAstro client:load />
  <ScrollToTop client:load />
</BaseLayout>
