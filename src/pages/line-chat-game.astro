---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavbarAstro from '../components/NavbarAstro';
import FooterAstro from '../components/FooterAstro';
import ScrollToTop from '../components/ScrollToTop';
import '../styles/global.css';

const title = 'LINE 聊天室遊戲介紹｜不用下載也能玩的 RPG';
const description = 'LINE 聊天室遊戲是什麼？本篇介紹可在 LINE 直接玩的遊戲類型、優點與適合族群，並分享 LineHero 無盡冒險的玩法特色。';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'LINE 聊天室遊戲是什麼？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'LINE 聊天室遊戲是指在 LINE 聊天視窗中就能進行操作的遊戲，不用下載 App。'
      }
    },
    {
      '@type': 'Question',
      name: 'LINE 聊天室遊戲適合哪些人？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '適合想利用碎片時間玩遊戲、或不能下載 App 的上班族與學生。'
      }
    },
    {
      '@type': 'Question',
      name: '有推薦的 LINE 聊天室 RPG 嗎？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'LineHero 無盡冒險提供聊天視窗戰鬥、掉寶通知與 Web 模式管理，是目前內容完整的 LINE 聊天室 RPG。'
      }
    }
  ]
};

const seoProps = {
  title,
  description,
  keywords: 'LINE聊天室遊戲,LINE聊天遊戲,LINE遊戲,line遊戲,聊天視窗RPG,免下載RPG,網頁RPG',
  url: 'https://linehero.tw/line-chat-game',
  type: 'article',
  schema: faqSchema
};
---

<BaseLayout {...seoProps}>
  <NavbarAstro client:load />

  <main class="bg-hero-dark min-h-screen pt-28 pb-16 px-4 md:px-8 text-gray-100">
    <article class="max-w-4xl mx-auto">
      <header class="mb-10">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10">
          <span class="w-2 h-2 rounded-full bg-hero-gold"></span>
          <span class="text-xs font-bold tracking-[0.2em] text-gray-200 uppercase">LINE 聊天室遊戲</span>
        </div>
        <h1 class="mt-6 text-3xl md:text-5xl font-black text-white leading-tight">LINE 聊天室遊戲介紹（免下載 RPG）</h1>
        <p class="mt-4 text-gray-300 leading-relaxed max-w-3xl">
          LINE 聊天室遊戲最大的優勢是「打開聊天視窗就能玩」。
          不用下載 App、不佔空間，適合碎片時間或上班空檔。這裡整理玩法特色與推薦方向。
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a href="https://lin.ee/3JlUhak" target="_blank" rel="noopener noreferrer"
             class="px-6 py-3 rounded-xl bg-[#06C755] hover:bg-[#05b34c] text-white font-black shadow-lg shadow-green-900/20">
            立即加入官方帳號
          </a>
          <a href="/game-intro-line" class="px-6 py-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-hero-gold text-white font-bold">
            LINE 版玩法介紹
          </a>
        </div>
      </header>

      <section class="space-y-10">
        <section class="space-y-4">
          <h2 class="text-2xl font-black text-white">LINE 聊天室遊戲的 3 個優勢</h2>
          <ul class="list-disc pl-6 space-y-2 text-gray-200">
            <li><strong class="text-white">免下載：</strong>直接在 LINE 裡開玩。</li>
            <li><strong class="text-white">低調上班可玩：</strong>看起來像在回訊息。</li>
            <li><strong class="text-white">即時通知：</strong>掉寶、事件、Boss 提醒不錯過。</li>
          </ul>
        </section>

        <section class="space-y-4">
          <h2 class="text-2xl font-black text-white">推薦玩法：LineHero 無盡冒險</h2>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 space-y-3">
            <p class="text-gray-300 leading-relaxed">
              在 LINE 聊天室遊戲中，LineHero 無盡冒險提供完整 RPG 養成：
              聊天視窗戰鬥 + Web 模式管理，並具備世界 Boss、副本、陣營與裝備成長。
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm text-gray-300">
              <div class="bg-black/40 border border-white/10 rounded-xl px-4 py-3">聊天視窗戰鬥</div>
              <div class="bg-black/40 border border-white/10 rounded-xl px-4 py-3">世界 Boss & 副本</div>
              <div class="bg-black/40 border border-white/10 rounded-xl px-4 py-3">Web 模式管理</div>
            </div>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="text-2xl font-black text-white">適合哪些人？</h2>
          <ul class="list-disc pl-6 space-y-2 text-gray-200">
            <li>想找「line 遊戲」但不想下載 App 的玩家。</li>
            <li>上班族或學生，想用碎片時間推進進度。</li>
            <li>喜歡聊天視窗互動、又想要 RPG 成長的人。</li>
          </ul>
        </section>

        <section class="border-t border-white/10 pt-8 space-y-4">
          <h2 class="text-2xl font-black text-white">開始方法</h2>
          <p class="text-gray-300">在 LINE 搜尋 <strong class="text-white">@linehero</strong>，或點擊下方連結加入好友即可開始。</p>
          <a class="inline-flex text-hero-gold font-bold" href="https://lin.ee/3JlUhak" target="_blank" rel="noreferrer">https://lin.ee/3JlUhak →</a>
        </section>
      </section>
    </article>
  </main>

  <FooterAstro client:load />
  <ScrollToTop client:load />
</BaseLayout>
