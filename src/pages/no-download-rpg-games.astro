---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavbarAstro from '../components/NavbarAstro';
import FooterAstro from '../components/FooterAstro';
import ScrollToTop from '../components/ScrollToTop';
import '../styles/global.css';

const title = '免下載 RPG 遊戲推薦｜不用安裝也能玩的 LINE 遊戲';
const description = '免下載 RPG 遊戲怎麼選？這篇整理「不用安裝、不佔手機空間」的選擇指南，並介紹可在 LINE 聊天室直接玩的 LineHero 無盡冒險。';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '什麼是免下載 RPG？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '免下載 RPG 指的是不需安裝 App 的 RPG，通常在 LINE 或瀏覽器即可遊玩。'
      }
    },
    {
      '@type': 'Question',
      name: '免下載 RPG 有哪些優點？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '不佔手機空間、進入速度快、上班或通勤都能快速開玩，而且可跨裝置同步。'
      }
    },
    {
      '@type': 'Question',
      name: 'LineHero 算免下載 RPG 嗎？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '是，LineHero 無盡冒險在 LINE 聊天室即可進入，不需要下載或安裝 App。'
      }
    }
  ]
};

const seoProps = {
  title,
  description,
  keywords: '免下載RPG,不用安裝遊戲,LINE遊戲,line遊戲,聊天視窗RPG,網頁RPG,上班玩遊戲',
  url: 'https://linehero.tw/no-download-rpg-games',
  type: 'article',
  schema: faqSchema
};
---

<BaseLayout {...seoProps}>
  <NavbarAstro client:load />

  <main class="bg-hero-dark min-h-screen pt-28 pb-16 px-4 md:px-8 text-gray-100">
    <article class="max-w-4xl mx-auto">
      <header class="mb-10">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10">
          <span class="w-2 h-2 rounded-full bg-hero-gold"></span>
          <span class="text-xs font-bold tracking-[0.2em] text-gray-200 uppercase">免下載 RPG</span>
        </div>
        <h1 class="mt-6 text-3xl md:text-5xl font-black text-white leading-tight">免下載 RPG 遊戲推薦（不用安裝也能玩）</h1>
        <p class="mt-4 text-gray-300 leading-relaxed max-w-3xl">
          你在找「免下載 RPG / 不用安裝的遊戲」嗎？
          這類型最適合不想佔手機空間、又想隨時能玩的玩家。以下整理挑選重點，並介紹一款可在 LINE 直接玩的遊戲：LineHero 無盡冒險。
        </p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a href="https://lin.ee/3JlUhak" target="_blank" rel="noopener noreferrer"
             class="px-6 py-3 rounded-xl bg-[#06C755] hover:bg-[#05b34c] text-white font-black shadow-lg shadow-green-900/20">
            立即加入官方帳號
          </a>
          <a href="/no-download-rpg" class="px-6 py-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-hero-gold text-white font-bold">
            免下載 RPG 介紹
          </a>
        </div>
      </header>

      <section class="space-y-10">
        <section class="space-y-4">
          <h2 class="text-2xl font-black text-white">免下載 RPG 的三大優勢</h2>
          <ul class="list-disc pl-6 space-y-2 text-gray-200">
            <li><strong class="text-white">不佔空間：</strong>不用安裝大型 App，手機輕鬆。</li>
            <li><strong class="text-white">隨時開玩：</strong>打開 LINE 或瀏覽器就能進入。</li>
            <li><strong class="text-white">跨裝置同步：</strong>手機、電腦都可接續進度。</li>
          </ul>
        </section>

        <section class="space-y-4">
          <h2 class="text-2xl font-black text-white">LineHero 為什麼適合免下載玩家</h2>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 space-y-3">
            <p class="text-gray-300 leading-relaxed">
              LineHero 無盡冒險是一款「LINE 遊戲」，不需下載 App。
              你只要加入官方帳號，就能在聊天視窗戰鬥、掉寶、養成，還能用 Web 模式管理裝備與排行榜。
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm text-gray-300">
              <div class="bg-black/40 border border-white/10 rounded-xl px-4 py-3">LINE 聊天室即玩</div>
              <div class="bg-black/40 border border-white/10 rounded-xl px-4 py-3">自動戰鬥 + 掉寶通知</div>
              <div class="bg-black/40 border border-white/10 rounded-xl px-4 py-3">Web 模式進階管理</div>
            </div>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="text-2xl font-black text-white">適合哪些人？</h2>
          <ul class="list-disc pl-6 space-y-2 text-gray-200">
            <li>手機容量不夠、但想玩 RPG 的玩家。</li>
            <li>通勤或上班空檔想快速開一局的人。</li>
            <li>喜歡養成與掉寶，但不想被下載綁住的人。</li>
          </ul>
        </section>

        <section class="border-t border-white/10 pt-8 space-y-4">
          <h2 class="text-2xl font-black text-white">開始方法</h2>
          <p class="text-gray-300">在 LINE 搜尋 <strong class="text-white">@linehero</strong>，或點擊下方連結加入好友即可開始。</p>
          <a class="inline-flex text-hero-gold font-bold" href="https://lin.ee/3JlUhak" target="_blank" rel="noreferrer">https://lin.ee/3JlUhak →</a>
        </section>
      </section>
    </article>
  </main>

  <FooterAstro client:load />
  <ScrollToTop client:load />
</BaseLayout>
