---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavbarAstro from '../components/NavbarAstro';
import { FeatureHubPageAstro } from '../components/FeatureHubPageAstro';
import FooterAstro from '../components/FooterAstro';
import ScrollToTop from '../components/ScrollToTop';
import '../styles/global.css';

const seoProps = {
  title: "功能介紹｜LINE Hero 無盡冒險（LINE遊戲／網頁遊戲玩法）",
  description: "一次看懂 LINE Hero 玩法：聊天室戰鬥（LINE遊戲）、Web 模式大螢幕管理（網頁遊戲）、組隊副本、區域 Boss、鐵匠鋪強化、背包與社交系統。",
  url: "https://linehero.tw/features"
};
---

<BaseLayout {...seoProps}>
  <NavbarAstro client:load />
  <main>
    <FeatureHubPageAstro client:load />
  </main>
  <FooterAstro client:load />
  <ScrollToTop client:load />
</BaseLayout>
