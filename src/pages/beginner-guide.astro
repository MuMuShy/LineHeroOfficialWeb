---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavbarAstro from '../components/NavbarAstro';
import BeginnerGuidePage, { getHowToSchema } from '../components/BeginnerGuidePage';
import FooterAstro from '../components/FooterAstro';
import ScrollToTop from '../components/ScrollToTop';
import '../styles/global.css';

const howToSchema = getHowToSchema();

const seoProps = {
  title: "新手攻略｜LINE Hero 無盡冒險（LINE遊戲／網頁遊戲入門）",
  description: "LINE Hero 新手入門教學：加入官方帳號→開始冒險→升級/配裝/強化。免下載 LINE遊戲 + Web 模式網頁遊戲，從 0 到上手一次看懂。",
  keywords: "LINE遊戲, 網頁遊戲, LINE Hero攻略, LINE Hero新手, 無盡冒險攻略, 免下載RPG攻略, 聊天視窗RPG教學",
  url: "https://linehero.tw/beginner-guide",
  schema: howToSchema
};
---

<BaseLayout {...seoProps}>
  <NavbarAstro client:load />
  <main>
    <BeginnerGuidePage client:load />
  </main>
  <FooterAstro client:load />
  <ScrollToTop client:load />
</BaseLayout>
